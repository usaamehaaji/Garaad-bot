# -*- coding: utf-8 -*-
import json, random

random.seed(42)

MC = []  # multiple choice
TF = []  # true/false

def add_mc(q, options, correct):
    assert correct in options, q
    assert len(options) == 4, q
    MC.append({"question": q, "options": options, "correct": correct})

def add_tf(q, correct):
    TF.append({"question": q, "type": "tf", "correct": correct})

