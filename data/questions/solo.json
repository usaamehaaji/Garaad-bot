function generate(count = 600) {
  const questions = [];
  let tIndex = 0;
  let fIndex = 0;

  // Alternate true/false roughly to balance; start with true
  for (let i = 0; i < count; i++) {
    const makeTrue = i % 2 === 0; // even indices true, odd false
    if (makeTrue) {
      const base = trueFacts[tIndex % trueFacts.length];
      // Add slight variation to avoid exact duplicates if we cycle
      const questionText = base;
      questions.push({
        question: questionText,
        type: "tf",
        correct: true
      });
      tIndex++;
    } else {
      const base = falseFacts[fIndex % falseFacts.length];
      const questionText = base;
      questions.push({
        question: questionText,
        type: "tf",
        correct: false
      });
      fIndex++;
    }
  }

  return questions;
}

function ensureDirExists(filePath) {
  const dir = path.dirname(filePath);
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
}

const OUT_PATH = path.join(__dirname, 'data', 'questions', 'solo_tf_600.json');
const questions = generate(600);
ensureDirExists(OUT_PATH);
fs.writeFileSync(OUT_PATH, JSON.stringify(questions, null, 2), 'utf8');
console.log(`Waa la dhameystiray: ${OUT_PATH} (su'aalo: ${questions.length})`);
